DATABASE_URL="postgresql://postgres:postgres@localhost:5432/upravnik?schema=public"
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# The app refuses to start with a short or placeholder secret.
JWT_SECRET=""
# Comma-separated list of allowed browser origins (HTTP and socket.io).
CORS_ORIGIN="http://localhost:3001"
PORT=3000
# S3-compatible file storage. Local dev uses RustFS from docker-compose (`npm run db:up`).
# For AWS S3 leave S3_ENDPOINT empty and set S3_FORCE_PATH_STYLE="false".
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="upravnik-files"
S3_ACCESS_KEY_ID="rustfsadmin"
S3_SECRET_ACCESS_KEY="rustfsadmin"
S3_FORCE_PATH_STYLE="true"
